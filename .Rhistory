library(wordcloud)
library(showtext)
# 提取数据
crop_start <- 5
crops <- data.frame(
crop = df[[1]][crop_start:nrow(df)],
count = as.numeric(df[[2]][crop_start:nrow(df)])
)
crops <- na.omit(crops)
# 提取数据
crop_start <- 5
