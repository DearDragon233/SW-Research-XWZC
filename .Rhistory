# 提取数据
library(readxl)
library(readr)  # 使用 parse_number
df <- read_excel("Data/Q_Rversion.xlsx", sheet = "Sheet1", col_names = FALSE)
# 提取作物数据
crop_start <- 5
crops <- data.frame(
crop = df[[1]][crop_start:nrow(df)],
count = parse_number(df[[2]][crop_start:nrow(df)])  # 更稳妥
)
crops <- na.omit(crops)  # 删除 NA 行
# 中文字体支持
showtext_auto()
png("Plot/crop_wordcloud.png", width = 800, height = 600)
wordcloud(words = crops$crop, freq = crops$count,
scale = c(4, 0.8), min.freq = 1,
colors = brewer.pal(8, "Dark2"), random.order = FALSE)
dev.off()
library(wordcloud)
library(showtext)
# 提取数据
library(readxl)
library(readr)  # 使用 parse_number
df <- read_excel("Data/Q_Rversion.xlsx", sheet = "Sheet1", col_names = FALSE)
# 提取作物数据
crop_start <- 5
crops <- data.frame(
crop = df[[1]][crop_start:nrow(df)],
count = parse_number(df[[2]][crop_start:nrow(df)])  # 更稳妥
)
crops <- data.frame(
crop = df[[1]][crop_start:nrow(df)],
count = parse_number(df[[2]][crop_start:nrow(df)])  # 更稳妥
)
crops <- na.omit(crops)  # 删除 NA 行
# 中文字体支持
showtext_auto()
png("Plot/crop_wordcloud.png", width = 800, height = 600)
wordcloud(words = crops$crop, freq = crops$count,
scale = c(4, 0.8), min.freq = 1,
colors = brewer.pal(8, "Dark2"), random.order = FALSE)
library(ggplot2)
p3 <- ggplot(crops, aes(x = reorder(crop, count), y = count, fill = count)) +
geom_col() +
coord_flip() +
geom_text(aes(label = count), hjust = -0.2, size = 4) +
scale_fill_gradient(low = "skyblue", high = "darkgreen") +
labs(title = "主要作物种植人数分布", x = "作物种类", y = "人数") +
theme_minimal(base_size = 14)
ggsave("Plot/crop_gradient_barplot.png", p3, width = 8, height = 6)
p3
