library(ggplot2)
library(readxl)
# 创建输出文件夹
dir.create("Plot", showWarnings = FALSE)
# 读取数据
df <- read_excel("Data/Q_Rversion.xlsx", sheet = "Sheet1", col_names = FALSE)
# 提取耕地面积信息（第1-2行）
land_area <- data.frame(
type = c(df[[1]][1], df[[1]][2]),
count = as.numeric(c(df[[2]][1], df[[2]][2]))
)
# 绘图
p1 <- ggplot(land_area, aes(x = type, y = count, fill = type)) +
geom_col(width = 0.6, show.legend = FALSE) +
labs(title = "耕地面积分类", x = "耕地类型", y = "人数") +
theme_minimal(base_size = 14)
